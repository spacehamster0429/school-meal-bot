[Unit]
Description=School Meal Discord Bot
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/school-meal-bot:latest
ContainerName=school-meal-bot
EnvironmentFile=%h/.config/school-meal-bot/school-meal-bot.env
Volume=%h/.local/share/school-meal-bot:/data:Z
UserNS=keep-id:uid=1000,gid=1000
Pull=never
PublishPort=127.0.0.1:3031:3031
ReadOnly=true
NoNewPrivileges=true
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=16m
HealthCmd=node -e "fetch('http://127.0.0.1:3032/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=3

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target
